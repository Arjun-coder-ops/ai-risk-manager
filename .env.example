# Development-only Docker Compose values. Never commit a populated .env file.
POSTGRES_DB=ai_risk
POSTGRES_USER=ai_risk
POSTGRES_PASSWORD=replace-with-a-local-development-password
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Set true only while creating an initial local administrator, then revert.
ALLOW_BOOTSTRAP_REGISTRATION=false
MAX_CSV_INGESTION_ROWS=1000
MAX_TRANSACTION_INGESTION_ROWS=1000
# Per-process fixed-window limits. Configure a shared gateway/rate-limit service
# before horizontally scaling; these values are not distributed across workers.
AUTH_RATE_LIMIT_PER_MINUTE=30
WRITE_RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_WINDOW_SECONDS=60
LOG_LEVEL=INFO
